# Copy to .env for a fully local deployment. Do not commit real tokens.
# Resolved relative to the directory used to start web_service.py.
# The directory must contain onnx/ and voice_styles/.
KORVATTS_ASSETS_DIR=assets
# false means only preloaded local model files are used; no Hugging Face download.
HF_MODEL_ONLINE=false
# Set false to keep API online while serving a Vietnamese "web disabled" message at /.
KORVATTS_WEB_ENABLED=true
# Generate a long random value; API requests require Authorization: Bearer <value>.
KORVATTS_API_TOKEN=replace-with-a-long-random-token
